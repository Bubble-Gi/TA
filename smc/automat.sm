%class Automat
%header automat.h
%start AutomatMap::Start


%map AutomatMap
%%
Start{
    ch(c :char)[c == 'c']        Cs     {}
}

Cs{
    ch(c :char)[c == 'r']        Rs     {}
}

Rs{
    ch(c :char)[c == 'e']        Es     {}
}

Es{
    ch(c :char)[c == 'a']        As     {}
}

As{
    ch(c :char)[c == 't']        Ts     {}
}

Ts{
    ch(c :char)[c == 'e']        Es2     {}
}

Es2{
    sp       Space1   {}
}

Space1{
    ch(c :char)     Name   {}
    num    Error  { setBad(); }
    sp     nil    {}
}

Name{
    ch(c :char)     nil    {}
    sp     Space2  {}
    num    nil    {}
}

Space2{
    ch(c :char)[c == 'a']      As2     {}
    o_b    OpenBracket  {}
    sp     nil     {}
}

OpenBracket{
    sp     Space3   {}
}

Space3{
    sp      nil     {}
    ch(c :char)      List   {}
    num     Error   { setBad(); }
    c_b     Error   {setBad(); }
}

List{
    ch(c :char)      nil     {}
    num     nil     {}
    comma   Comma   {}
    sp      Space4  {}
}

Comma{
    ch(c :char)      List    {}
    num     Error   { setBad(); }
    sp      Error   { setBad(); }
}

Space4{
    c_b     Close_bracket  {}
    sp      nil      {}
}

Close_bracket{
    EOS     Ok       { setGood(); }
}

As2{
    ch(c :char)[c == 's']       Ss        {}
}

Ss{
    sp      Space5     {}
}

Space5{
    sp     nil    {}
    ch(c :char)     Name0  {}
    num    Error  { setBad(); }
}

Name0{
    ch(c :char)     nil    {}
    sp     Space6  {}
    num    nil    {}
}

Space6{
    sp     nil    {}
    ch(c :char)[c == 'j']      Js     {}
}

Js{
    ch(c :char)[c == 'o']      Os     {}
}

Os{
    ch(c :char)[c == 'i']      Is     {}
}

Is{
    ch(c :char)[c == 'n']      Ns      {}
}

Ns{
    sp     Space7   {}
}

Space7{
    sp     nil     {}
    ch(c :char)     Name1   {}
    num    Error   { setBad(); }
}

Name1{
    ch(c :char)     nil    {}
    sp     nil    {}
    num    nil    {}
    EOS    Ok     { setGood(); }
}

Error{
    num     nil   { setBad(); setS }
    sp      nil  {setBad();}
    Unknown nil { setBad(); }
    start    nil   {}
    ch(c : char)     nil    {}
    comma    nil   {}
    o_b      nil    {}
    c_b      nil    {}
    EOS      OK  {}
}

Ok{
    start    Start   {}
}

Default {
    Unknown  Error  { setBad(); }
    ch(c :char)   Error    { setBad(); }
}
%%